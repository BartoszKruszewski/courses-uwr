    "tailwindcss": "^4.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.8",
    "vitest-browser-react": "^2.2.0"
  }
